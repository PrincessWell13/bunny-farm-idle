; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bunny Farm Idle"
config/description="An idle game about breeding rabbits."
config/version="0.1.0"
config/tags=PackedStringArray("mobile", "idle", "casual")
run/main_scene="res://prototypes/core-loop-prototype/main.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/core/event_bus.gd"
TimeManager="*res://src/core/time_manager.gd"
EconomyManager="*res://src/core/economy_manager.gd"
GameState="*res://src/core/game_state.gd"
RabbitSystem="*res://src/core/rabbit_system.gd"
ExpeditionSystem="*res://src/core/expedition_system.gd"
GeneticsSystem="*res://src/core/genetics_system.gd"
IdleProductionSystem="*res://src/core/idle_production_system.gd"
SaveSystem="*res://src/core/save_system.gd"
SceneManager="*res://src/core/scene_manager.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="portrait"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
